# ============================================================================
# Springfield Archive — .gitignore
# Java, Maven, IntelliJ, VS Code, artefactos del sistema operativo,
# archivos temporales y secretos
# ============================================================================

# ---------- Secretos y entorno (los reales nunca deben subirse) ----------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
*.pub.key
secrets/
**/application-local.*
# El perfil local SIN secretos forma parte del código y debe seguir versionado.
!backend/src/main/resources/application-local.yml
**/application-secret.*
**/application-secrets.*
credentials.json
service-account*.json

# ---------- Java ----------
*.class
*.log
logs/
hs_err_pid*
replay_pid*
pid.txt
*.hprof
*.jfr
*.war
*.ear
*.sar
dependency-reduced-pom.xml

# ---------- Maven ----------
target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
.flattened-pom.xml
# El wrapper se mantiene en el repositorio para que la versión de Maven
# empleada sea conocida y controlada:
# (mvnw, mvnw.cmd, .mvn/wrapper/*) se incluyen a propósito y NO se ignoran
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar.sha256
!.mvn/wrapper/maven-wrapper.jar

# ---------- Gradle (por si aparece en el futuro) ----------
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar

# ---------- Herramientas frontend de Node ----------
node_modules/
dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.vite/
.cache/

# ---------- IntelliJ IDEA ----------
.idea/
*.iml
*.ipr
*.iws
out/
.idea_modules/

# ---------- VS Code ----------
.vscode/*
!.vscode/extensions.json

# ---------- Eclipse / NetBeans (defensivo) ----------
.classpath
.project
.settings/
bin/
nbproject/private/
nbbuild/
nbdist/
.nb-gradle/

# ---------- Linux ----------
*~
.directory
.fuse_hidden*
.nfs*
lost+found/

# ---------- Windows ----------
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# ---------- macOS ----------
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# ---------- Archivos temporales y de respaldo ----------
*.tmp
*.temp
*.bak
*.swp
*.swo
*.orig
*.rej
*.old
~$*
*.part
*.crdownload

# ---------- Artefactos de tests / cobertura ----------
coverage/
*.lcov
jacoco.exec
*.ec
surefire-reports/
failsafe-reports/
