#!/usr/bin/env bash
# Lanzador ejecutable para Omarchy/Linux. No borra volúmenes ni datos.
set -euo pipefail
ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT_DIR"
if ! command -v python3 >/dev/null 2>&1; then
  printf 'ERROR: se requiere Python 3.\n' >&2
  exit 2
fi
exec python3 scripts/omarchy-launcher.py "$@"
