# ============================================================
# Springfield Archive — .env.example (backend/)
# Copia a .env y RELLENA valores locales. Los valores aquí son
# FICTICIOS y claramente de ejemplo. NUNCA subas .env a Git.
# .env está ignorado por el .gitignore de la raíz del repositorio.
# ============================================================

# Usuario administrador de PostgreSQL local (ejemplo ficticio)
POSTGRES_USER=springfield_example_user
# Contraseña LOCAL de desarrollo (ejemplo ficticio; no es un secreto real)
POSTGRES_PASSWORD=springfield_example_password_change_me
# Base de datos a crear en el contenedor (ejemplo ficticio)
POSTGRES_DB=springfield_example_db
